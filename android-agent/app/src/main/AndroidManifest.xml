<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <!-- ← FIX: ACCESS_FINE_LOCATION was completely MISSING from the manifest.
         On targetSdk < 33, this is the ONLY permission that unmasks WifiInfo.
         On targetSdk >= 33 it is still required alongside NEARBY_WIFI_DEVICES
         because some OEM ROMs (Samsung One UI, Redmi MIUI) still check it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ← FIX: NEARBY_WIFI_DEVICES now has android:usesPermissionFlags="neverForLocation"
         and tools:targetApi="33" as required for targetSdk 33+.
         This unmasks WifiInfo from NetworkCapabilities.transportInfo on API 33+
         WITHOUT requiring location services to be turned on.
         neverForLocation is safe here because WiFi identity (SSID/BSSID) is used
         purely for security monitoring, NOT for deriving physical location. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required for FOREGROUND_SERVICE_TYPE_DATA_SYNC — tells Android this service
         syncs data continuously. Without this the startForeground() call with
         DATA_SYNC type will throw a SecurityException on API 34+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REBOOT" />
    <uses-permission android:name="android.permission.DEVICE_POWER" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="com.samsung.android.providers.context.permission.READ_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Hotel Agent"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <!-- Main activity WITHOUT launcher intent-filter.
             The alias below controls icon visibility — disabling the alias
             removes the icon; MainActivity itself always stays enabled so
             services, intents, and deep-links keep working. -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <!-- ← NEW: activity-alias that owns the LAUNCHER intent-filter.
             Disabling this alias = icon disappears from home screen.
             Enabling it again = icon reappears.
             targetActivity (.MainActivity) is NEVER disabled.
             NOTE: icon and label are intentionally omitted — this project has
             no mipmap/ or values/ resource folders (programmatic UI only).
             The alias inherits both from the parent <application> element. -->
        <activity-alias
            android:name=".MainActivityAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.LockActivity"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:showForAllUsers="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".ui.WifiPinDialog"
            android:theme="@android:style/Theme.Dialog"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:exported="false" />

        <activity
            android:name=".ui.PowerOffPinDialog"
            android:theme="@android:style/Theme.Dialog"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:launchMode="singleTask"
            android:exported="false" />

        <activity
            android:name=".admin.AdminActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.DayNight" />

        <activity
            android:name=".admin.CalibrationActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.DayNight" />

        <activity
            android:name=".admin.ProvisioningActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.DayNight" />

        <service
            android:name=".service.KioskService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync|location"
            android:stopWithTask="false" />

        <service
            android:name=".WrongNetworkOverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false" />

        <receiver
            android:name=".admin.HotelDeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".security.UninstallReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".security.WifiStateReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter android:priority="999">
                <action android:name="android.net.wifi.WIFI_STATE_CHANGED" />
                <action android:name="android.net.wifi.STATE_CHANGE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".security.ShutdownReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.ACTION_SHUTDOWN" />
                <action android:name="android.intent.action.REBOOT" />
                <action android:name="android.intent.action.QUICKBOOT_POWEROFF" />
                <action android:name="com.android.internal.intent.action.REQUEST_SHUTDOWN" />
            </intent-filter>
        </receiver>

        <service
            android:name=".security.WiFiMonitoringService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="DOZE_ALARM" />
            </intent-filter>
        </service>

        <service
            android:name=".security.WatchdogService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="WATCHDOG_ALARM" />
            </intent-filter>
        </service>

        <!-- BootReceiver: restarts WiFiMonitoringService after device reboot.
             exported=true is required so the OS can deliver BOOT_COMPLETED.
             RECEIVE_BOOT_COMPLETED permission declared above. -->
        <receiver
            android:name=".security.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <!-- Standard boot completed action -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- HTC / LG / Lenovo fast-boot: fires instead of BOOT_COMPLETED
                     on some OEM ROMs when the device wakes from deep sleep. -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        
        <receiver android:name=".security.ScreenAndWiFiReceiver"
                  android:enabled="true"
                  android:exported="false" />

            <receiver
            android:name=".security.DozeAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- ← NEW: SecretDialerReceiver — listens for admin dialing the secret
             USSD code (*#*#7378423#*#*) or the numeric alias (7378423).
             Both intent-filters are in ONE receiver block to avoid duplicate
             name errors in the manifest merger.
             When triggered, re-enables MainActivityAlias → icon reappears,
             then opens AdminActivity behind the existing PIN gate. -->
        <receiver
            android:name=".security.SecretDialerReceiver"
            android:enabled="true"
            android:exported="true">

            <!-- Path 1: tel: URI dialed — inspects number, matches SECRET_CODE -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <data android:scheme="tel" />
            </intent-filter>

            <!-- Path 2: *#*#7378423#*#* USSD — fires before dialer opens -->
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />
                <data
                    android:scheme="android_secret_code"
                    android:host="7378423" />
            </intent-filter>

        </receiver>
    </application>

    <uses-permission android:name="android.permission.RESTART_PACKAGES" />
</manifest>
